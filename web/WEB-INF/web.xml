<?xml version="1.0" ?>
<web-app
		xmlns = "https://jakarta.ee/xml/ns/jakartaee"
		xmlns:xsi = "http://www.w3.org/2001/XMLSchema-instance"
		xsi:schemaLocation = "https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-app_5_0.xsd"
		version = "5.0"
		metadata-complete = "false">

	<display-name>TSI Sign</display-name>

	<welcome-file-list>
		<welcome-file>index.html</welcome-file>
	</welcome-file-list>

	<!--
	  Force revalidation on every static asset request (console HTML/CSS/JS)
	  instead of Jetty's default heuristic caching off Last-Modified, which
	  let browsers keep serving a page from before the last redeploy.
	-->
	<servlet>
		<servlet-name>default</servlet-name>
		<servlet-class>org.eclipse.jetty.ee10.servlet.DefaultServlet</servlet-class>
		<init-param>
			<param-name>cacheControl</param-name>
			<param-value>no-cache</param-value>
		</init-param>
		<!--
		  Jetty's bundled webdefault-ee10.xml sets dirAllowed=true, so a directory with no
		  welcome file would be auto-listed. Welcome-file resolution (/console/ ->
		  /console/index.html) is tried first and is unaffected.
		-->
		<init-param>
			<param-name>dirAllowed</param-name>
			<param-value>false</param-value>
		</init-param>
	</servlet>
	<servlet-mapping>
		<servlet-name>default</servlet-name>
		<url-pattern>/</url-pattern>
	</servlet-mapping>

	<!--
	  TSI framework standard pattern (matches tsi-ledger/tsi-dpdp-cms/
	  tsi-privacy-vault): a single InterceptingFilter dispatches every
	  /api/v1/* POST request to an Action class resolved from
	  _processor.tsi, keyed by resource path; the specific operation is
	  the "_func" field in the JSON body, not a URL path segment or verb.
	-->
	<filter>
		<filter-name>InterceptingFilter</filter-name>
		<filter-class>org.tsicoop.sign.framework.InterceptingFilter</filter-class>
	</filter>
	<filter-mapping>
		<filter-name>InterceptingFilter</filter-name>
		<url-pattern>/api/*</url-pattern>
		<dispatcher>REQUEST</dispatcher>
	</filter-mapping>

	<!--
	  Server-side gate for the console HTML pages (deny by default; the public login-flow
	  pages are allowlisted inside the filter). Independent of the Bearer-token auth that
	  InterceptingFilter enforces on every /api call.
	-->
	<filter>
		<filter-name>ConsoleAuthFilter</filter-name>
		<filter-class>org.tsicoop.sign.framework.ConsoleAuthFilter</filter-class>
	</filter>
	<filter-mapping>
		<filter-name>ConsoleAuthFilter</filter-name>
		<url-pattern>/console/*</url-pattern>
		<dispatcher>REQUEST</dispatcher>
		<dispatcher>FORWARD</dispatcher>
	</filter-mapping>

	<!--
	  Return leg of the CCA eSign flow: the ESP form-POSTs the signed response back here through
	  the signer's browser, so it can't use the JSON /api/v1 convention (see EsignReturnServlet).
	-->
	<servlet>
		<servlet-name>EsignReturn</servlet-name>
		<servlet-class>org.tsicoop.sign.service.v1.EsignReturnServlet</servlet-class>
	</servlet>
	<servlet-mapping>
		<servlet-name>EsignReturn</servlet-name>
		<url-pattern>/esign/return/*</url-pattern>
	</servlet-mapping>

	<!-- LEGACY INTEGRATION: browser return for document-upload providers (eMudhra CoreGateway). -->
	<servlet>
		<servlet-name>LegacyEsignReturn</servlet-name>
		<servlet-class>org.tsicoop.sign.esign.legacyintegration.LegacyEsignReturnServlet</servlet-class>
	</servlet>
	<servlet-mapping>
		<servlet-name>LegacyEsignReturn</servlet-name>
		<url-pattern>/esign/legacy-return/*</url-pattern>
	</servlet-mapping>
</web-app>
