<?xml version="1.0" ?>
<web-app
		xmlns = "https://jakarta.ee/xml/ns/jakartaee"
		xmlns:xsi = "http://www.w3.org/2001/XMLSchema-instance"
		xsi:schemaLocation = "https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-app_5_0.xsd"
		version = "5.0"
		metadata-complete = "false">

	<display-name>TSI Sign</display-name>

	<welcome-file-list>
		<welcome-file>index.html</welcome-file>
	</welcome-file-list>

	<listener>
		<listener-class>org.tsicoop.sign.framework.AppBootstrapListener</listener-class>
	</listener>

	<filter>
		<filter-name>ApiKeyAuthenticationFilter</filter-name>
		<filter-class>org.tsicoop.sign.security.ApiKeyAuthenticationFilter</filter-class>
	</filter>
	<filter-mapping>
		<filter-name>ApiKeyAuthenticationFilter</filter-name>
		<url-pattern>/api/v1/*</url-pattern>
		<dispatcher>REQUEST</dispatcher>
	</filter-mapping>

	<!--
	  ConsoleSessionAuthenticationFilter's mapping must be declared AFTER
	  ApiKeyAuthenticationFilter's above: for a request under /api/v1/admin/*,
	  both patterns match, and filters run in the order their mappings are
	  declared here — ApiKeyAuthenticationFilter passes admin paths straight
	  through, then this one actually gates them on a platform_user session.
	-->
	<filter>
		<filter-name>ConsoleSessionAuthenticationFilter</filter-name>
		<filter-class>org.tsicoop.sign.security.ConsoleSessionAuthenticationFilter</filter-class>
	</filter>
	<filter-mapping>
		<filter-name>ConsoleSessionAuthenticationFilter</filter-name>
		<url-pattern>/api/v1/admin/*</url-pattern>
		<dispatcher>REQUEST</dispatcher>
	</filter-mapping>

	<servlet>
		<servlet-name>PingServlet</servlet-name>
		<servlet-class>org.tsicoop.sign.api.v1.PingServlet</servlet-class>
	</servlet>
	<servlet-mapping>
		<servlet-name>PingServlet</servlet-name>
		<url-pattern>/api/v1/ping</url-pattern>
	</servlet-mapping>

	<servlet>
		<servlet-name>TemplatesServlet</servlet-name>
		<servlet-class>org.tsicoop.sign.api.v1.TemplatesServlet</servlet-class>
	</servlet>
	<servlet-mapping>
		<servlet-name>TemplatesServlet</servlet-name>
		<url-pattern>/api/v1/templates/*</url-pattern>
	</servlet-mapping>

	<servlet>
		<servlet-name>DocumentsServlet</servlet-name>
		<servlet-class>org.tsicoop.sign.api.v1.DocumentsServlet</servlet-class>
	</servlet>
	<servlet-mapping>
		<servlet-name>DocumentsServlet</servlet-name>
		<url-pattern>/api/v1/documents/*</url-pattern>
	</servlet-mapping>

	<servlet>
		<servlet-name>AdminSetupServlet</servlet-name>
		<servlet-class>org.tsicoop.sign.api.v1.admin.AdminSetupServlet</servlet-class>
	</servlet>
	<servlet-mapping>
		<servlet-name>AdminSetupServlet</servlet-name>
		<url-pattern>/api/v1/admin/setup</url-pattern>
	</servlet-mapping>
	<servlet-mapping>
		<servlet-name>AdminSetupServlet</servlet-name>
		<url-pattern>/api/v1/admin/setup-status</url-pattern>
	</servlet-mapping>

	<servlet>
		<servlet-name>AdminAuthServlet</servlet-name>
		<servlet-class>org.tsicoop.sign.api.v1.admin.AdminAuthServlet</servlet-class>
	</servlet>
	<servlet-mapping>
		<servlet-name>AdminAuthServlet</servlet-name>
		<url-pattern>/api/v1/admin/auth/*</url-pattern>
	</servlet-mapping>

	<servlet>
		<servlet-name>AdminAppsServlet</servlet-name>
		<servlet-class>org.tsicoop.sign.api.v1.admin.AdminAppsServlet</servlet-class>
	</servlet>
	<servlet-mapping>
		<servlet-name>AdminAppsServlet</servlet-name>
		<url-pattern>/api/v1/admin/apps/*</url-pattern>
	</servlet-mapping>

	<servlet>
		<servlet-name>AdminLegalCertificatesServlet</servlet-name>
		<servlet-class>org.tsicoop.sign.api.v1.admin.AdminLegalCertificatesServlet</servlet-class>
	</servlet>
	<servlet-mapping>
		<servlet-name>AdminLegalCertificatesServlet</servlet-name>
		<url-pattern>/api/v1/admin/legal-certificates/*</url-pattern>
	</servlet-mapping>

	<servlet>
		<servlet-name>AdminPlatformUsersServlet</servlet-name>
		<servlet-class>org.tsicoop.sign.api.v1.admin.AdminPlatformUsersServlet</servlet-class>
	</servlet>
	<servlet-mapping>
		<servlet-name>AdminPlatformUsersServlet</servlet-name>
		<url-pattern>/api/v1/admin/platform-users/*</url-pattern>
	</servlet-mapping>
</web-app>
