# --- Database Configuration ---
POSTGRES_DB=tsi_sign
POSTGRES_USER=tsi_sign_admin
POSTGRES_PASSWD=<generate-a-strong-password>

# --- Application Configuration ---
TSI_SIGN_ENV=local

# Mount path for the local_fs DocumentStorageProvider (Phase 1 default, §5.1).
# docker-compose.yml already mounts a named volume here; only change this if
# you want documents on a different mounted path/volume.
STORAGE_LOCAL_FS_PATH=/data/tsi-sign/documents

# Local PKI KeyStore for seal-local (§7). The Docker image bakes in a
# self-signed dev keypair (alias tsi_corporate_seal) at these defaults —
# override all three to point at a real org-issued .p12/.jks for anything
# beyond local evaluation.
KEYSTORE_PATH=/etc/tsi-sign/keystore.p12
KEYSTORE_TYPE=PKCS12
KEYSTORE_PASSWORD=changeit

# --- Docker Compose port mapping (optional overrides) ---
# docker-compose.yml already defaults to 5440/8088 to avoid colliding with
# other TSI products' 5432-5439/8080-8087 on a shared evaluation host.
# Only set these if 5440/8088 also collide with something on your machine.
# APP_PORT_MAP=8088:8080
# DB_PORT_MAP=5440:5432

# --- eSign (BYO-CA) ---
# Browser-reachable base URL of this server (eSign redirect + the CA's return URL).
# PUBLIC_BASE_URL=http://localhost:8088
# Provider used when neither the request nor the App names one. "sandbox" is the bundled MOCK CA.
# DEFAULT_ESIGN_PROVIDER_ID=sandbox
# A real CA (emudhra | cdac | protean | vsign | capricorn | xtratrust | cca_generic) - all required:
# ESIGN_EMUDHRA_URL=<the CA's eSign form endpoint>
# ESIGN_EMUDHRA_ASP_ID=<your ASP id from that CA>
# ESIGN_EMUDHRA_TRUST_CERTS=/etc/tsi-sign/emudhra-ca.pem   # CA/CCA cert(s) the signer's cert chains to
# ESIGN_EMUDHRA_ESP_CERT=/etc/tsi-sign/emudhra-esp.pem     # the ESP's response-signing cert (pinned)
# ESIGN_EMUDHRA_ASP_KEY_ALIAS=tsi_asp_signing               # your ASP request-signing key in KEYSTORE_PATH

# --- Time-stamping (optional; PAdES-B-B -> B-T) ---
# An RFC 3161 time-stamp authority: proves a signature existed at a point in time even after the
# signer's certificate expires. TSA_TRUST_CERTS (PEM of the TSA's CA) is required with TSA_URL.
# TSA_REQUIRED=true fails the signing if the TSA is down; false degrades to B-B (recorded on the seal).
# TSA_URL=
# TSA_TRUST_CERTS=
# TSA_REQUIRED=false
